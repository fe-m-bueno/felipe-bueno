{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contentful:login": "contentful login",
    "contentful:migrate": "sh -c 'set -a; [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a; TOKEN=\"${CONTENTFUL_MANAGEMENT_TOKEN:-$CONTENTFUL_MANAGEMENT_ACCESS_TOKEN}\"; contentful space migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT_ID:-master}\" ${TOKEN:+--management-token \"$TOKEN\"} --yes \"$1\"' --",
    "contentful:generate-migration": "sh -c 'set -a; [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a; contentful space generate migration --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"${CONTENTFUL_ENVIRONMENT_ID:-master}\"'",
    "contentful:seed": "sh -c 'set -a; [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; set +a; node contentful/seed.js'"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@headlessui/react": "^2.2.0",
    "@iconify/react": "^5.2.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "contentful": "^11.5.7",
    "disposable-email-domains": "^1.0.62",
    "flag-icons": "^7.3.2",
    "i18next": "^24.2.3",
    "lucide-react": "^0.482.0",
    "next": "^16.2.10",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.4.1",
    "resend": "^4.1.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "contentful-cli": "^4.0.2",
    "contentful-management": "^12.8.0",
    "contentful-migration": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "fluid-tailwind": "^1.0.4",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "shadcn": "^4.16.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
